{
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=SoccerInfo;MultipleActiveResultSets=true;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "PlaywrightOptions": {
    "Headless": false
  },
  "TransactionSettings": {
    "ResolveType": "Rollback"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/log_.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ExtractAndSavePlayersCharacteristicsCommand": {
    "BatchSize": 100
  },
  "GeneralExtraction": {
    "IsActive": false
  }
}
